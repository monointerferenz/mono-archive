{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mono-archive",
  "version": "0.1.0",
  "identifier": "de.monointerferenz.mono-archive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mono-archive",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
