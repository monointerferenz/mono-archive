    "moduleResolution": "bundler",
    "target": "esnext",
    "module": "esnext",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "src/**/*.svelte"],
  "exclude": ["node_modules", "dist", "src-tauri", "DEV-RESOURCES"]
}
